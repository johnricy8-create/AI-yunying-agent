# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，禁止提交。
# 阶段一不需要任何密钥；阶段二启用 GLM + RAG 时需要 ZHIPU_API_KEY。

LOG_LEVEL=INFO

# 智谱 BigModel：GLM-4.7-Flash 对话 + embedding-3 向量
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

# 备选：如改用硅基流动 BGE-M3，需要额外配置并调整代码；
# 当前阶段二默认使用智谱 embedding-3，不启用 BGE-M3。
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
