# 阶段一不调用任何外部 API，本文件仅作为配置样例。
# 真实密钥请写入项目根目录的 .env，.env 已被 .gitignore 排除。
# 不要把密钥提交到 Git，也不要放进 settings.yaml。

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 阶段二接入对话模型后再启用以下配置
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=
#
# BGE-M3 属于嵌入模型，阶段一、阶段二核心流程均不使用；
# 如未来启用历史报告语义检索，再配置 EMBEDDING_MODEL。
# EMBEDDING_MODEL=BAAI/bge-m3
